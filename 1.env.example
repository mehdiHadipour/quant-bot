TELEGRAM_TOKEN=
TELEGRAM_CHAT=
ENCRYPTION_KEY=
SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,XRPUSDT,ADAUSDT,DOGEUSDT,AVAXUSDT,LINKUSDT,DOTUSDT,ZECUSDT,SUIUSDT,TONUSDT,NEARUSDT
MIN_SIGNAL_PROBABILITY=70
MIN_ADX=25
ATR_SL_MULTIPLIER=1.8
ATR_TP_MULTIPLIER=3.0
RISK_PERCENT_PER_TRADE=1.0
CYCLE_MINUTES=10
MAX_CONCURRENT_TRADES=4
MAX_DAILY_LOSS_R=3
MAX_OPEN_RISK_R=4
MIN_REWARD_RISK=1.5
MAX_SAME_DIRECTION_OPEN=3
TRAILING_TRIGGER_R=0.5
PARTIAL_LOCK_TRIGGER_R=0.75
PARTIAL_LOCK_R=0.5
SILENCE_GAP_MULTIPLIER=6
SYMBOL_COOLDOWN_CYCLES=6

# V28 Smart Context (optional sidecars; no fake defaults)
SMART_CONTEXT_MODE=live
WHALE_BIAS_FILE=
FUNDAMENTAL_FILE=
# Or use inline JSON:
# WHALE_BIAS_JSON={"BTCUSDT":{"bias":"BUY","confidence":0.82}}
# FUNDAMENTAL_JSON={"BTCUSDT":{"score":2}}
# Direction restrictions are disabled by default; only populate after OOS validation.
BUY_ONLY_SYMBOLS=
SELL_ONLY_SYMBOLS=
NEWS_ENABLED=1

# V29 ICT Full Context
# New entries are allowed ONLY during London/New York local sessions.
NEWS_ENABLED=1
NEWS_BLOCK_MINUTES=30
MIN_HYPER_LIQUIDITY=35
# For historical backtests, keep NEWS_ENABLED=0 unless you provide timestamped news sidecar data.

# V30.7 defensive policy: these symbols/sessions are deliberately stricter.
STRICT_SYMBOLS=ADAUSDT,AVAXUSDT,BTCUSDT,DOGEUSDT,DOTUSDT,LINKUSDT,SUIUSDT,TONUSDT,XRPUSDT,ZECUSDT
STRICT_MIN_SCORE=80
STRICT_MIN_HLI=70
COUNTERTREND_MIN_SCORE=82
NEGATIVE_SESSIONS=ASIA,NEW_YORK
NEGATIVE_SESSION_MIN_SCORE=80
NEGATIVE_SESSION_MIN_HLI=70
ASIA_ENABLED=1
ASIA_START=09:00
ASIA_END=18:00

# V30.9 WEEX TradFi research-first controls
TRADFI_ENABLED=1
TRADFI_LIVE_APPROVAL_REQUIRED=1
TRADFI_APPROVED_SYMBOLS=
TRADFI_APPROVAL_FILE=state/tradfi_approval.json
TRADFI_BACKTEST_DAYS=90
TRADFI_MIN_TRADES=30
TRADFI_MIN_PF=1.25
TRADFI_MAX_DD_R=8
