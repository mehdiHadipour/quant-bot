# Copy to .env for local runs. Never commit real values.
TELEGRAM_TOKEN=
TELEGRAM_CHAT=
ENCRYPTION_KEY=
# Optional strategy/risk overrides; defaults live in config.py.
# Default 14 crypto symbols shown below; config.py's own Python default
# (used whenever this file's SYMBOLS is left unset/commented out) also
# includes the 4 verified WEEX commodity symbols: XAUUSDT,XAGUSDT,CLUSDT,
# NATGASUSDT. To add commodities/indices explicitly here, uncomment and
# edit the line below — the last 4 tickers (NAS100USDT,US30USDT,
# SPX500USDT,HK50USDT) are UNVERIFIED candidates researched for V27.19;
# confirm they're real WEEX contract symbols before enabling them (see
# data_engine.py's WEEX_COMMODITY_SYMBOLS comment).
SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,XRPUSDT,ADAUSDT,DOGEUSDT,AVAXUSDT,LINKUSDT,DOTUSDT,ZECUSDT,SUIUSDT,TONUSDT,NEARUSDT
# SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,XRPUSDT,ADAUSDT,DOGEUSDT,AVAXUSDT,LINKUSDT,DOTUSDT,ZECUSDT,SUIUSDT,TONUSDT,NEARUSDT,XAUUSDT,XAGUSDT,CLUSDT,NATGASUSDT,NAS100USDT,US30USDT,SPX500USDT,HK50USDT
MIN_SIGNAL_PROBABILITY=70
MIN_ADX=25
ATR_SL_MULTIPLIER=1.8
ATR_TP_MULTIPLIER=1.8
RISK_PERCENT_PER_TRADE=1.0
SL_WARNING_THRESHOLD=0.8
TRAILING_TRIGGER_R=0.5
PARTIAL_LOCK_TRIGGER_R=0.75
PARTIAL_LOCK_R=0.5
NEAR_TP_LOCK_TRIGGER_R=0.90
NEAR_TP_LOCK_R=0.70
TIME_STOP_SCHEDULE=4:0.10,8:0.30
CYCLE_MINUTES=10
SYMBOL_COOLDOWN_CYCLES=6
MAX_CONCURRENT_TRADES=4
MAX_DAILY_LOSS_R=3
MAX_OPEN_RISK_R=4
MIN_REWARD_RISK=1.0
MAX_SAME_DIRECTION_OPEN=3
