# Copy to .env for local runs. Never commit real values.
TELEGRAM_TOKEN=
TELEGRAM_CHAT=
ENCRYPTION_KEY=
# Optional strategy/risk overrides; defaults live in config.py.
# Default 8 crypto symbols shown below, matching config.py's V27.22
# policy (based on the user's own real trading results, not an
# independent backtest finding — see config.py's SYMBOLS comment):
# BTCUSDT/ETHUSDT/XRPUSDT/ADAUSDT/SUIUSDT/TONUSDT fully removed;
# BNBUSDT/SOLUSDT/AVAXUSDT/LINKUSDT/NEARUSDT kept but SELL-only (see
# SELL_ONLY_SYMBOLS below); DOGEUSDT/DOTUSDT/ZECUSDT fully bidirectional.
# config.py's own Python default (used whenever this file's SYMBOLS is
# left unset/commented out) also includes the 4 verified WEEX commodity
# symbols: XAUUSDT,XAGUSDT,CLUSDT,NATGASUSDT. To add commodities/indices/
# forex explicitly here, uncomment and edit the line below — the last 8
# tickers (NAS100USDT,US30USDT,SPX500USDT,HK50USDT,EURUSDT,GBPUSDT,
# USDJPYUSDT,AUDUSDT) are UNVERIFIED candidates researched for
# V27.19/V27.21; confirm they're real WEEX contract symbols before
# enabling them (see data_engine.py's WEEX_COMMODITY_SYMBOLS comment).
SYMBOLS=BNBUSDT,SOLUSDT,DOGEUSDT,AVAXUSDT,LINKUSDT,DOTUSDT,ZECUSDT,NEARUSDT
# SYMBOLS=BNBUSDT,SOLUSDT,DOGEUSDT,AVAXUSDT,LINKUSDT,DOTUSDT,ZECUSDT,NEARUSDT,XAUUSDT,XAGUSDT,CLUSDT,NATGASUSDT,NAS100USDT,US30USDT,SPX500USDT,HK50USDT,EURUSDT,GBPUSDT,USDJPYUSDT,AUDUSDT
# Symbols allowed to trade SELL only (a BUY signal for any of these is
# treated as no-signal-this-cycle) — see config.py's direction_allowed().
SELL_ONLY_SYMBOLS=BNBUSDT,SOLUSDT,AVAXUSDT,LINKUSDT,NEARUSDT
MIN_SIGNAL_PROBABILITY=70
MIN_ADX=25
ATR_SL_MULTIPLIER=1.8
ATR_TP_MULTIPLIER=1.8
RISK_PERCENT_PER_TRADE=1.0
SL_WARNING_THRESHOLD=0.8
TRAILING_TRIGGER_R=0.5
PARTIAL_LOCK_TRIGGER_R=0.75
PARTIAL_LOCK_R=0.5
NEAR_TP_LOCK_TRIGGER_R=0.90
NEAR_TP_LOCK_R=0.70
TIME_STOP_SCHEDULE=4:0.10,8:0.30
CYCLE_MINUTES=10
SYMBOL_COOLDOWN_CYCLES=6
MAX_CONCURRENT_TRADES=4
MAX_DAILY_LOSS_R=3
MAX_OPEN_RISK_R=4
MIN_REWARD_RISK=1.0
MAX_SAME_DIRECTION_OPEN=3
